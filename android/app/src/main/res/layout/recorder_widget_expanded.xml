<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ONE TAP • REC"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/widget_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Recorder settings"
            android:padding="6dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_record_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_record_circle"
            android:contentDescription="Record"
            android:padding="15dp"
            android:src="@drawable/ic_record" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START RECORDING"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="4K • 30 FPS"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUDIO  DEVICE + MIC"
        android:textColor="#66FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
